{
  "functions": {
    "source": "functions",
    "runtime": {
      "env": [
        "PAYSTACK_SECRET_KEY",
        "PAYSTACK_WEBHOOK_SECRET"
      ]
    }
  },
  "emulators": {
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "auth": { "port": 9099 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
